    <string name="intimate_charts_empty">添加更多数据后再来看看吧！</string>
    <string name="intimate_charts_walking_title">步行与晨间</string>
    <string name="intimate_charts_alcohol_title">饮酒与晨间</string>
    <string name="intimate_charts_legend_average">你的平均值</string>
    <string name="intimate_charts_legend_night">每晚睡眠小时数</string>
