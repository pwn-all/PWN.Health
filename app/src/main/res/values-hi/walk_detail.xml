<resources>
    <string name="walk_share">सैर साझा करें</string>
    <string name="walk_delete">सैर हटाएँ</string>
    <string name="walk_delete_title">यह सैर हटाएँ?</string>
    <string name="walk_delete_body">यह सैर अपने रूट, आँकड़ों और फ़ोटो के साथ फ़ोन से हमेशा के लिए हट जाएगी। जो फ़ाइलें आप पहले सहेज या साझा कर चुके हैं, वे जहाँ हैं वहीं रहेंगी।</string>
    <string name="walk_photos">फ़ोटो</string>
    <string name="walk_photos_help">संख्याएँ मानचित्र पर बने निशानों से मेल खाती हैं, जो बताते हैं कि हर फ़ोटो कहाँ ली गई थी। जब फ़ोन GPS से अपना स्थान तय नहीं कर पाया था, तब ली गई फ़ोटो का कोई निशान नहीं होता। दिशा कंपास का वह कोण है जिसकी ओर फ़ोटो ली गई थी, और इसे भौगोलिक उत्तर से गिना जाता है। झुकाव बताता है कि फ़ोन क्षितिज से कितना ऊपर या नीचे की ओर था। पोर्ट्रेट या लैंडस्केप बताता है कि फ़ोन किस तरह पकड़ा गया था।</string>
