<resources>
    <string name="walk_share">Compartir la ruta</string>
    <string name="walk_delete">Eliminar la ruta</string>
    <string name="walk_delete_title">¿Eliminar esta ruta?</string>
    <string name="walk_delete_body">La ruta, sus datos y sus fotos se borran del teléfono para siempre. Los archivos que ya hayas guardado o compartido se quedan donde están.</string>
    <string name="walk_photos">Fotos</string>
    <string name="walk_photos_help">Los números coinciden con los marcadores del mapa, que muestran dónde se hizo cada foto. Una foto hecha cuando el teléfono no tenía señal de GPS no tiene marcador. La dirección es el rumbo de brújula hacia el que se hizo la foto, contado desde el norte geográfico. La inclinación es cuánto apuntaba el teléfono por encima o por debajo del horizonte. «Vertical» u «horizontal» indica cómo se sostenía el teléfono.</string>
    <string name="walk_photo_facing">%1$s %2$d°</string>
    <string name="walk_photo_facing_spoken">hacia el %1$s</string>
