    <string name="walk_photo_down">%1$d° abajo</string>
    <string name="walk_photo_level">nivelada</string>
    <string name="walk_photo_portrait">vertical</string>
    <string name="walk_photo_landscape">horizontal</string>
    <string name="walk_photo_upside_down">al revés</string>
    <string name="walk_photo_no_direction">rumbo desconocido</string>
    <string name="walk_photo_spoken">Foto %1$d: %2$s</string>
    <string name="walk_photo_delete">Eliminar la foto %1$d</string>
    <string name="walk_photo_delete_body">La imagen se borra del teléfono para siempre; la ruta en la que se hizo se queda.</string>
