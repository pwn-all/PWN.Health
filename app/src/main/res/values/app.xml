    <color name="ic_launcher_background">#FFFFFF</color>

    <!--
      Platform theme, no AppCompat/Material dependency: Compose draws everything.

      The system bars are set here as well as by enableEdgeToEdge(), because not every window makes
      that call: the medicine alarm and the quick entry widget's setup screen draw straight from this
      theme. DeviceDefault leaves windowLightStatusBar false, which by day would give those two
      windows white bar icons over a light bar or a light page. light_system_bars turns over with
      the night qualifier, which is the same signal isSystemInDarkTheme() reads for every
      PwnFitTheme in the app; a window that does call enableEdgeToEdge() replaces all four items at
      runtime.
    -->
    <style name="Theme.Steps" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
    <bool name="light_system_bars">true</bool>
