<?xml version="1.0" encoding="utf-8"?>
<!--
  First frame only: the preview's shape with no week on it — seven slivers where the bars will
  stand and a caption without a figure — which can stand until the half-hourly update after a boot.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/colorAccent" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_week_initial"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />
</LinearLayout>
