<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:ignore="Overdraw">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="3dp"
        android:padding="6dp"
        android:contentDescription="@string/water_title"
        android:src="@drawable/ic_art_water" />
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="3dp"
        android:padding="6dp"
        android:contentDescription="@string/add_meal"
        android:src="@drawable/ic_art_food" />
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="3dp"
        android:padding="6dp"
        android:contentDescription="@string/add_section_activity"
        android:src="@drawable/ic_art_sport" />
</LinearLayout>
