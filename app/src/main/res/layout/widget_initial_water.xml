<?xml version="1.0" encoding="utf-8"?>
<!--
  First frame only: the widget's name where the caption goes and a dash where the portions go. The
  preview's day and its millilitre buttons stay in the picker: this frame can stand for half an hour
  after a boot, before the first update has read either the day's drinks or the unit the profile
  reads in, and it carries no tap for a button to answer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/water_title"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingVertical="15dp"
        android:text="@string/insight_no_value"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
