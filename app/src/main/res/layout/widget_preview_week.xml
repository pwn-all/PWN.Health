<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview only: seven bars of a plausible week, today's the tallest, over the week's caption — drawn
  like the widget, since a sentence in a picker tells a person nothing about what will land.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <View
            android:layout_width="14dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/textColorSecondary" />

        <View
            android:layout_width="14dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="5dp"
            android:background="?android:attr/colorAccent" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_week_caption"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />
</LinearLayout>
