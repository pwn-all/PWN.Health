<?xml version="1.0" encoding="utf-8"?>
<!--
  The report on its way out of the phone: a sheet with a medical badge and the months of a record
  drawn as three bars, over the soft discs the rest of the drawn set stands on.

  The card has no drop shadow, since a vector drawable has no blur; it keeps an eight-degree tilt.

  Its intrinsic size is the size it is drawn at, since Lint holds vector icons to 200dp and the
  screen asks for 116dp of it anyway.

  Painted in named colours with a night twin, like the duotone set: the discs share one colour and
  the bars another, and the discs are told apart by their own fillAlpha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="256"
    android:viewportHeight="256">
