    <string name="walk_photo_portrait">pionowo</string>
    <string name="walk_photo_landscape">poziomo</string>
    <string name="walk_photo_upside_down">do góry nogami</string>
    <string name="walk_photo_no_direction">kierunek nieznany</string>
    <string name="walk_photo_spoken">Zdjęcie %1$d: %2$s</string>
    <string name="walk_photo_delete">Usuń zdjęcie %1$d</string>
    <string name="walk_photo_delete_body">Zdjęcie zniknie z telefonu na dobre. Spacer, podczas którego je zrobiono, zostanie.</string>
