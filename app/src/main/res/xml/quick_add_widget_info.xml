<?xml version="1.0" encoding="utf-8"?>
<!--
  The three labels are this widget's only targets, so they are padded to Android's 48dp minimum:
  48.1dp of row inside a frame that spends 10dp top and bottom is 68.1dp, declared as 70dp.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:description="@string/widget_quick_description"
    android:initialLayout="@layout/widget_preview_quick"
    android:previewLayout="@layout/widget_preview_quick"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
