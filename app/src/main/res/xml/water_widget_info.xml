<?xml version="1.0" encoding="utf-8"?>
<!--
  The two minima are what the face measures, not round numbers. Four portion buttons at 16sp with
  4dp of side padding are 177.1dp of labels — 186.6dp when the profile reads in fluid ounces — and
  each of the four is also a tap target, so the row wants 4 x 48dp inside a frame that spends 10dp
  a side: 212dp, declared as 215dp, which is what a three-cell widget gives anyway. Any narrower and
  the user could drag the widget down until a button falls off the end. Height is the caption's
  14.1dp over a 48.75dp row — Android's 48dp tap minimum — plus the frame's 10dp top and bottom:
  82.8dp, declared as 85dp. Both are the resize floor, not the placed size; one cell still holds it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="215dp"
    android:minHeight="85dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:description="@string/widget_water_description"
    android:initialLayout="@layout/widget_initial_water"
    android:previewLayout="@layout/widget_preview_water"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
