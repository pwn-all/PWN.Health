<?xml version="1.0" encoding="utf-8"?>
<!--
  The next dose beside its Taken, which is padded to the 48.75dp target the track widget's Stop measured; with the frame the face is 68.8dp, declared as 70dp.
  The 30 minutes is the platform floor, and the day rolls over with nobody touching the phone: the
  period is what turns yesterday's figure into today's. The first frame is the preview's shape with
  no figure on it (WidgetMetadataTest).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_dose_description"
    android:initialLayout="@layout/widget_initial_dose"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:previewLayout="@layout/widget_preview_dose"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
