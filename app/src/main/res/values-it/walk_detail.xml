    <string name="walk_photo_landscape">orizzontale</string>
    <string name="walk_photo_upside_down">sottosopra</string>
    <string name="walk_photo_no_direction">direzione sconosciuta</string>
    <string name="walk_photo_spoken">Foto %1$d: %2$s</string>
    <string name="walk_photo_delete">Elimina la foto %1$d</string>
    <string name="walk_photo_delete_body">La foto viene eliminata dal telefono per sempre. Il percorso durante il quale è stata scattata resta.</string>
