    <string name="walk_photo_level">без наклона</string>
    <string name="walk_photo_portrait">вертикально</string>
    <string name="walk_photo_landscape">горизонтально</string>
    <string name="walk_photo_upside_down">вверх ногами</string>
    <string name="walk_photo_no_direction">направление неизвестно</string>
    <string name="walk_photo_spoken">Фото %1$d: %2$s</string>
    <string name="walk_photo_delete">Удалить фото %1$d</string>
    <string name="walk_photo_delete_body">Фотография удалится с телефона навсегда. Прогулка, на которой она снята, останется.</string>
