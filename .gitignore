build/
.gradle/
.kotlin/
local.properties
*.iml
.idea/
.DS_Store

# Generated Python caches (the scripts under tools/ write them).
__pycache__/
*.pyc
.pytest_cache/

# JVM and tool outputs
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
